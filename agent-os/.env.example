# === Claude Code (Abo-Auth) ===
# Einmal am Laptop erzeugen:  claude setup-token
# Der Token ist an dein Max-Abo gebunden -> Abrechnung ueber das Abo, nicht die API.
CLAUDE_CODE_OAUTH_TOKEN=

# WICHTIG: KEIN ANTHROPIC_API_KEY setzen. Wenn gesetzt, gewinnt er still
# und du wirst per Token ueber die API abgerechnet.

# === Harness-Zugang (Single-User) ===
# Starkes Zufallstoken; das Frontend sendet es als Bearer.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HARNESS_TOKEN=

# === Voice-Provider (optional, je nach config.yaml) ===
ELEVENLABS_API_KEY=
GROQ_API_KEY=
