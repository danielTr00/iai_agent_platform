# Gateway-Zugang (Single-User): python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=

# Claude Code Abo-Auth (claude setup-token) — NUR fuer claude-core
CLAUDE_CODE_OAUTH_TOKEN=

# NIEMALS setzen (Startup-Guard bricht sonst ab): ANTHROPIC_API_KEY

# Voice-Provider (optional)
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# Verhalten
GATEWAY_EMIT_TOOL_EVENTS=status   # status | silent | raw
GATEWAY_STREAM_IDLE_TIMEOUT=300
